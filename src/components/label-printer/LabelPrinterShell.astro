---
const { logoSrc } = Astro.props;

const panelClass = "min-w-0 rounded-lg border border-default bg-default shadow-lg";
const headingClass = "flex items-center justify-between gap-3 border-b border-default px-4 py-4";
const eyebrowClass = "m-0 font-bold uppercase tracking-normal text-offset text-xs";
const inputClass = "w-full rounded-lg border border-default bg-default px-3 py-2 font-sans text-default focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary";
const primaryButtonClass = "min-h-11 rounded-lg border border-primary bg-primary px-4 py-2 font-black text-default transition-colors hover:bg-secondary disabled:cursor-not-allowed disabled:border-default disabled:bg-offset disabled:text-offset";
const secondaryButtonClass = "min-h-9 rounded-lg border border-primary bg-default px-4 py-1.5 font-black text-accent transition-colors hover:bg-offset";
const tableHeadClass = "sticky top-0 z-10 border-b border-default bg-offset px-2.5 py-3 text-left align-top font-black text-accent text-xs";
---

<main class="mx-auto max-w-[1160px] px-4 py-6 pb-10 text-default">
  <header class="flex items-center justify-between gap-4 border-b-2 border-primary pb-4 max-md:flex-col max-md:items-start">
    <div class="flex min-w-0 items-center gap-3">
      <img class="h-9 w-9" src={logoSrc} alt="" />
      <div>
        <p class={eyebrowClass}>Orble Production</p>
        <h1 class="m-0 font-extrabold leading-tight text-accent text-xl">Label Printer</h1>
      </div>
    </div>
    <p id="connectionStatus" class="m-0 min-h-6 text-right text-offset max-md:text-left">
      Connect a QL-600 to print.
    </p>
  </header>

  <div class="grid gap-6 pt-6 lg:grid-cols-[minmax(560px,1fr)_minmax(330px,390px)]">
    <section class={panelClass} aria-labelledby="productionHeading">
      <div class={headingClass}>
        <div>
          <h2 id="productionHeading" class="m-0 font-extrabold leading-tight text-accent text-lg">
            Labels to Print
          </h2>
        </div>
        <button id="reloadPlanButton" type="button" class={secondaryButtonClass}>Reload</button>
      </div>

      <div class="mx-4 mt-4 rounded-lg border border-default bg-offset p-3 font-bold text-offset">
        Selected <strong class="text-accent"><span id="selectedLabelCount">0</span> of <span id="planLabelCount">0</span></strong> labels
      </div>
      <p class="mx-4 mb-0 mt-2 text-offset text-sm">
        Includes one extra backup label for each drink variation.
      </p>

      <label class="mx-4 my-4 flex items-center gap-3 font-extrabold text-accent">
        <input id="selectEverything" class="h-[18px] w-[18px] accent-primary" type="checkbox" checked />
        <span>Select everything</span>
      </label>

      <div class="max-h-[min(52vh,520px)] overflow-auto border-y border-default">
        <table class="w-full border-separate border-spacing-0 text-sm">
          <thead>
            <tr>
              <th class={`${tableHeadClass} w-12 pl-6 pr-0`} aria-label="Selected"></th>
              <th class={tableHeadClass}>Drink</th>
              <th class={`${tableHeadClass} orble-table-number`}>Labels</th>
              <th class={`${tableHeadClass} orble-table-number`}>Machine</th>
              <th class={`${tableHeadClass} orble-table-number`}>Storage</th>
            </tr>
          </thead>
          <tbody id="planRows">
            <tr>
              <td class="border-b border-default px-2.5 py-3 text-default" colspan="5">Loading production plan...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="grid gap-3 p-4 md:grid-cols-2">
        <button id="connectButton" type="button" class={primaryButtonClass}>Connect QL-600</button>
        <button id="printSelectedButton" type="button" class={primaryButtonClass} disabled>Print Selected</button>
      </div>
    </section>

    <section class={panelClass} aria-labelledby="previewHeading">
      <div class={headingClass}>
        <div>
          <p class={eyebrowClass}>Test Label</p>
          <h2 id="previewHeading" class="m-0 font-extrabold leading-tight text-accent text-lg">Preview</h2>
        </div>
      </div>

      <canvas
        id="preview"
        class="mx-4 mt-4 block h-auto w-[calc(100%-2rem)] border border-default bg-default"
        width="566"
        height="165"
        aria-label="Label preview"
      ></canvas>

      <div class="grid gap-3 p-4">
        <label class="grid gap-1.5 font-extrabold text-accent">
          Drink
          <input id="drinkName" class={inputClass} value="Matcha 16oz Less Sugar" />
        </label>
        <label class="grid gap-1.5 font-extrabold text-accent">
          Code
          <input id="labelCode" class={inputClass} value="30TH#21" />
        </label>
        <label class="grid gap-1.5 font-extrabold text-accent">
          Expiration
          <input id="expirationDate" class={inputClass} value="09/28/26" />
        </label>
      </div>

      <button id="printOneButton" type="button" class={`${primaryButtonClass} mx-4 mb-4 w-[calc(100%-2rem)]`}>
        Print Test Label
      </button>

      <div class="mx-4 mb-4 rounded-lg border border-default bg-offset p-3" aria-live="polite">
        <p class={eyebrowClass}>Status Log</p>
        <pre id="log" class="mt-2 max-h-48 min-h-32 overflow-auto whitespace-pre-wrap font-mono leading-normal text-default text-xs"></pre>
      </div>
    </section>
  </div>
</main>
