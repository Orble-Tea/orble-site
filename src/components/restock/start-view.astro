---
import bob from "~/assets/images/logo_inkscape.svg";
import {
  KNOWN_FLAVORS,
  KNOWN_SIZES,
  KNOWN_TOPPINGS,
  LESS_SWEET,
  REGULAR_SWEETNESS,
} from "~/lib/restock/drink-parsing.js";

interface Props {
  machines: { label: string; machineId?: string }[];
  today: string;
}
const { machines, today } = Astro.props;
const drinkNameRules: [string, string[]][] = [
  ["Valid flavor", [...KNOWN_FLAVORS].sort()],
  ["Valid size", KNOWN_SIZES],
  ["Valid sweetness", [LESS_SWEET, REGULAR_SWEETNESS]],
  ["Valid topping", KNOWN_TOPPINGS.map((topping) => `w/ ${topping}`)],
];
---

<script src="/lottie-player.js" defer is:inline></script>
<!-- ============ loading overlay: bob waves while the log loads or submits ============ -->
<div
  id="loading-overlay"
  class="fixed inset-0 z-50 hidden flex-col items-center justify-center bg-white/85 backdrop-blur-sm"
>
  <lottie-player
    src="/bob-waving.json"
    autoplay
    loop
    style="width: 220px; height: 220px;"></lottie-player>
  <div id="loading-label" class="font-semibold text-orble-ink">Loading…</div>
</div>
<section
  id="view-start"
  class="flex min-h-screen flex-col items-center justify-start p-6 pt-10"
>
  <div class="mb-8 text-center">
    <img src={bob.src} alt="Orble" class="mx-auto mb-3 h-20" />
    <div class="font-heading text-gray-900 text-3xl">ORBLE</div>
    <div class="text-gray-400 text-sm">Restock Portal</div>
  </div>

  <div
    id="start-card"
    class="w-full max-w-sm rounded-3xl bg-white p-6 shadow-md"
  >
    <div id="start-status" class="mb-4 hidden rounded-xl px-3 py-2 text-[13px]">
    </div>

    <label
      class="mb-2 block font-semibold uppercase tracking-wide text-gray-500 text-xs"
      >Machine</label
    >
    <div class="mb-5 grid grid-cols-2 gap-3">
      {
        machines.map((m, i) => (
          <label class={m.machineId ? "cursor-pointer" : ""}>
            <input
              type="radio"
              name="machine"
              value={m.label}
              checked={i === 0 && !!m.machineId}
              disabled={!m.machineId}
              class="peer hidden"
            />
            <div
              class={
                m.machineId
                  ? "rounded-2xl border-2 border-gray-200 p-4 text-center transition peer-checked:border-orble-dark peer-checked:bg-orble-tint"
                  : "rounded-2xl border-2 border-gray-100 bg-gray-50 p-4 text-center opacity-60"
              }
            >
              <div
                class={
                  m.machineId
                    ? "font-semibold text-gray-900 text-base"
                    : "font-semibold text-gray-400 text-base"
                }
              >
                {m.label}
              </div>
              {!m.machineId && (
                <div class="mt-0.5 text-[11px] text-gray-400">
                  not set up yet
                </div>
              )}
            </div>
          </label>
        ))
      }
    </div>

    <label
      class="mb-2 block font-semibold uppercase tracking-wide text-gray-500 text-xs"
      >Batch date</label
    >
    <input
      id="batch-date"
      type="date"
      value={today}
      class="w-full rounded-2xl border-2 border-gray-200 bg-white px-4 py-3 text-gray-800 text-base focus:border-orble-dark focus:outline-none"
    />
    <p class="mb-6 mt-1.5 leading-snug text-[11px] text-gray-400">
      The date the drinks were made.
    </p>

    <button
      id="start-log"
      class="w-full rounded-2xl bg-orble-dark py-4 font-semibold text-white shadow-md transition text-base active:scale-[0.99]"
    >
      Start log
    </button>
  </div>

  <div
    id="drink-help"
    class="hidden w-full max-w-sm rounded-3xl bg-white p-6 shadow-md"
  >
    <div class="mb-4 flex items-center gap-3">
      <button
        id="drink-help-close"
        aria-label="Close"
        class="h-8 w-8 shrink-0 rounded-full bg-gray-100 font-bold text-gray-600 text-base active:bg-gray-200"
        >×</button
      >
      <div class="font-semibold text-gray-900 text-base">
        What are valid drink names?
      </div>
    </div>

    <p class="mb-4 leading-snug text-[13px] text-gray-500">
      A drink name is a flavor and a size with option values for sweetness and
      topping.
    </p>
    {
      drinkNameRules.map(([part, allowed]) => (
        <div class="mb-4">
          <div class="mb-2 font-semibold uppercase tracking-wide text-gray-500 text-xs">
            {part}
          </div>
          <div class="flex flex-wrap gap-2">
            {allowed.map((value) => (
              <span class="rounded-full bg-gray-100 px-4 py-2 text-gray-700 text-sm">
                {value}
              </span>
            ))}
          </div>
        </div>
      ))
    }
    <div
      class="mb-2 font-semibold uppercase tracking-wide text-gray-500 text-xs"
    >
      Examples
    </div>
    <div class="flex flex-wrap gap-2">
      <span class="rounded-full bg-orble-tint px-4 py-2 text-orble-ink text-sm">
        Thai Tea 16oz Less Sweet w/ Lychee
      </span>
      <span class="rounded-full bg-orble-tint px-4 py-2 text-orble-ink text-sm">
        Matcha 22oz
      </span>
    </div>
  </div>
</section>

<script>
  import { batch } from "nanostores";
  import { HTTP, esc, plannedNew, type Slot } from "~/lib/restock/ui-helpers";
  import { MESSAGES } from "~/lib/restock/errors.js";
  import {
    $,
    $payload,
    $slots,
    $showErrors,
    setStartedAt,
    navigate,
    KEY,
    type RestockPayload,
  } from "~/components/restock/runtime";
  import { restoreDraft } from "~/components/restock/drafts";

  const STRINGS = {
    noConnection:
      "No connection. Check your signal and try again. Nothing was lost.",
    invalidKey:
      "This link isn't valid. Ask for the current restock link and re-save your bookmark.",
    nayaxUnreachable: "Couldn't reach Nayax",
    keptForRetry: "Your machine and date are kept. Try again.",
    notConnected: (machine: string) =>
      `${machine} isn't connected to Nayax yet.`,
    genericError: "Something went wrong. Try again.",
    drinkHelp: "What are valid drink names?",
  };

  const STATUS_STYLES: Record<string, string> = {
    error: "bg-red-50 border border-red-200 text-red-700",
    warn: "bg-amber-50 border border-amber-200 text-amber-800",
    info: "bg-orble-tint text-orble-ink",
  };

  /** Shows a status box under the header (error/warn/info), or hides it. */
  function startStatus(kind: string | null, html?: string) {
    document
      .getElementById("loading-overlay")!
      .classList.replace("flex", "hidden");
    const el = $("start-status");
    if (!kind) return el.classList.add("hidden");
    el.className = `mb-4 rounded-xl px-3 py-2 text-[13px] ${STATUS_STYLES[kind]}`;
    el.innerHTML = html || "";
    el.classList.remove("hidden");
  }

  /** The invalid-drinks 409 as a list: one bullet per unreadable Inventory row. */
  function invalidDrinksHtml(details: {
    sheet: string;
    machine: string;
    invalidDrinks: { name: string; reason: string }[];
  }) {
    const items = details.invalidDrinks
      .map((row) => `<li>${esc(row.name)} (${esc(row.reason)})</li>`)
      .join("");
    return `<div>${esc(MESSAGES.invalidDrinksIntro(details.sheet, details.machine))}</div>
      <ul class="my-1.5 list-disc pl-5">${items}</ul>
      <div>${MESSAGES.fixDrinkNames}</div>`;
  }

  /** Appends the "What are valid drink names?" button to the status box. */
  function showDrinkHelpButton() {
    const button = document.createElement("button");
    button.id = "drink-help-open";
    button.className =
      "mt-2 flex w-fit items-center gap-1.5 rounded-full bg-white/70 px-3 py-1 text-xs font-medium text-orble-ink active:bg-white";
    button.innerHTML = `<span class="inline-flex h-4 w-4 items-center justify-center rounded-full border border-current text-[10px] font-bold">?</span>${STRINGS.drinkHelp}`;
    button.addEventListener("click", () => toggleDrinkHelp(true));
    $("start-status").append(button);
  }

  /** Swaps the start card for the drink-name help card, or back. */
  function toggleDrinkHelp(open: boolean) {
    $("start-card").classList.toggle("hidden", open);
    $("drink-help").classList.toggle("hidden", !open);
  }

  /** Builds editable slots from the payload, applying backend warnings. */
  function initSlots(payload: RestockPayload): Slot[] {
    const warned = new Map(
      (payload.warnings || [])
        .filter((w) => w.slot !== undefined)
        .map((w) => [w.slot, w]),
    );
    return payload.slots.map((s: any) => ({
      ...s,
      newCount: plannedNew(s),
      approved: false,
      edited: false,
      warning: warned.get(s.slot)?.code,
      warningReason: warned.get(s.slot)?.reason,
      warningMessage: warned.get(s.slot)?.message,
    }));
  }

  /**
   * Fetches the batch data for the chosen machine and date, hydrates the
   * stores, restores any draft, and opens the table view.
   */
  async function startLog() {
    const machine =
      document.querySelector<HTMLInputElement>("input[name=machine]:checked")
        ?.value || "";
    const date = ($("batch-date") as HTMLInputElement).value;
    if (!machine || !date) return;
    document.getElementById("loading-label")!.textContent = "Loading…";
    document
      .getElementById("loading-overlay")!
      .classList.replace("hidden", "flex");
    let response: Response;
    try {
      response = await fetch(
        `/api/restock?key=${encodeURIComponent(KEY)}&machine=${encodeURIComponent(machine)}&date=${encodeURIComponent(date)}`,
      );
    } catch {
      startStatus("error", STRINGS.noConnection);
      return;
    }
    let body: any = {};
    try {
      body = await response.json();
    } catch {
      /* non-JSON body falls through to the generic error below */
    }
    if (!response.ok) {
      if (response.status === HTTP.FORBIDDEN) {
        startStatus("error", STRINGS.invalidKey);
      } else if (response.status === HTTP.CONFLICT) {
        if (body.details?.invalidDrinks) {
          startStatus("info", invalidDrinksHtml(body.details));
          showDrinkHelpButton();
        } else {
          startStatus("info", body.error || STRINGS.genericError);
        }
      } else if (response.status === HTTP.BAD_GATEWAY) {
        startStatus(
          "warn",
          `${body.error || STRINGS.nayaxUnreachable}. ${STRINGS.keptForRetry}`,
        );
      } else if (
        response.status === HTTP.SERVER_ERROR &&
        /not configured/i.test(body.error || "")
      ) {
        startStatus("warn", STRINGS.notConnected(machine));
      } else {
        startStatus("error", STRINGS.genericError);
      }
      return;
    }
    startStatus(null);
    setStartedAt(Date.now());
    $("approve-banner").classList.add("hidden");
    $("complete-hint").classList.add("hidden");
    batch(() => {
      $payload.set(body);
      $showErrors.set(false);
      $slots.set(initSlots(body));
    });
    restoreDraft();
    navigate("table");
  }

  $("start-log").addEventListener("click", startLog);
  $("drink-help-close").addEventListener("click", () => toggleDrinkHelp(false));
</script>
